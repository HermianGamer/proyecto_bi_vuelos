# Copiar como .env y completar (no subir .env al repositorio)
DB_DRIVER=ODBC Driver 18 for SQL Server

# Local (Docker): localhost  |  Azure: <servidor>.database.windows.net
DB_SERVER=localhost
DB_ORIGEN=VuelosOrigen
DB_DW=VuelosDW

# Usuario administrador (solo para el ETL)
DB_USER=sa
DB_PASSWORD=cambiar_aqui

# Usuarios de la app (se crean en la fase del dashboard, ver sql/03_usuarios_app.sql)
DB_LECTOR_USER=app_lector
DB_LECTOR_PASSWORD=cambiar_aqui
DB_EDITOR_USER=app_editor
DB_EDITOR_PASSWORD=cambiar_aqui